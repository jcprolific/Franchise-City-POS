# Copy to .env.local for local dev, then add the same keys in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# Franchise City landing page — used by the login back arrow
VITE_LANDING_URL=https://franchise-city-landing.vercel.app
# Optional: Web Push VAPID public key (also served by push-config edge function)
VITE_VAPID_PUBLIC_KEY=
